@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <h2 class="mb-3">DANH SÁCH DANH MỤC SẢN PHẨM</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>